# Vectorforge configuration (all optional). Copy to .env and adjust.

# Where uploads and job metadata are stored (one folder per image token)
VF_DATA_DIR=./data/jobs
# How long uploads are kept, in hours (API clients can override per request
# with policy.retention_days, up to 30 days)
VF_RETENTION_HOURS=24
# Background vectorization threads per server process
VF_WORKERS=2
# Number of finished results kept in memory (others are recomputed on demand)
VF_MAX_CACHED_RESULTS=64
# Comma-separated API keys required for /api/v1/* (empty = open API).
# Send as X-API-Key header or HTTP Basic auth (key as username or password).
VF_API_KEYS=
# Requests per minute per client IP for vectorize/download/jobs (0 = unlimited)
VF_RATE_LIMIT_PER_MIN=120
# Allow image.url to point at private/loopback addresses (keep 0 in production)
VF_ALLOW_PRIVATE_URLS=0
